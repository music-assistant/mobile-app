<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup exclusions for API 31+ (`android:dataExtractionRules`).
  API 28-30 uses `backup_rules.xml` instead — keep the two in sync.

  Both sections must exclude the file. `cloud-backup` covers Google Drive
  backup. `device-transfer` covers a direct phone-to-phone copy, which is a
  separate path and is not covered by `cloud-backup`.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="AppSecrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="AppSecrets.xml" />
    </device-transfer>
</data-extraction-rules>
