<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV banner (android:banner on <application>): the 320x180dp tile shown
    in the Google TV / Leanback launcher's app row. Reuses the existing adaptive
    launcher icon centered over the launcher background color.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:width="100dp"
        android:height="100dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
