<?xml version="1.0" encoding="utf-8"?>
<!--
    The watch keeps nothing worth restoring: the server token is compiled in and the only
    stored value is which player was last controlled. Both transports are therefore empty.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
